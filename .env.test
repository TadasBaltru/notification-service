# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
# .env points SMTP at Mailpit. Tests capture mail on the null transport instead.
MAILER_DSN=null://null
# Same sliding window as production (300 / 1 hour); a smaller limit so the 4th send is enough.
NOTIFICATIONS_THROTTLE_LIMIT=3
